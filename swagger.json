            "format": "int32"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/h11.CommentViewModel"
            }
          }
        },
        "additionalProperties": false
      },
      "Paginator<h12.PostViewModel>": {
        "required": ["items"],
        "type": "object",
        "properties": {
          "pagesCount": {
            "type": "integer",
            "format": "int32"
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "totalCount": {
            "type": "integer",
            "format": "int32"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/h12.PostViewModel"
            }
          }
        },
        "additionalProperties": false
      },
      "h02.db.BlogInputModel": {
        "required": ["description", "name", "websiteUrl"],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 15,
            "type": "string"
          },
          "description": {
            "maxLength": 500,
            "type": "string"
          },
          "websiteUrl": {
            "maxLength": 100,
            "pattern": "^https://([a-zA-Z0-9_-]+\\.)+[a-zA-Z0-9_-]+(\\/[a-zA-Z0-9_-]+)*\\/?$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "h02.db.BlogPostInputModel": {
        "required": ["content", "shortDescription", "title"],
        "type": "object",
        "properties": {
          "title": {
            "maxLength": 30,
            "type": "string"
          },
          "shortDescription": {
            "maxLength": 100,
            "type": "string"
          },
          "content": {
            "maxLength": 1000,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "h02.db.PostInputModel": {
        "required": ["blogId", "content", "shortDescription", "title"],
        "type": "object",
        "properties": {
          "title": {
            "maxLength": 30,
            "type": "string"
          },
          "shortDescription": {
            "maxLength": 100,
            "type": "string"
          },
          "content": {
            "maxLength": 1000,
            "type": "string"
          },
          "blogId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "h03.BlogViewModel": {
        "required": ["description", "id", "name", "websiteUrl"],
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "websiteUrl": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "isMembership": {
            "type": "boolean",
            "description": "True if user has not expired membership subscription to blog"
          }
        },
        "additionalProperties": false
      },
      "h04.SortDirections": {
        "enum": ["asc", "desc"],
        "type": "string"
      },
      "h05.db.UserInputModel": {
        "required": ["email", "login", "password"],
        "type": "object",
        "properties": {
          "login": {
            "maxLength": 10,
            "minLength": 3,
            "pattern": "^[a-zA-Z0-9_-]*$",
            "type": "string",
            "description": "must be unique"
          },
          "password": {
            "maxLength": 20,
            "minLength": 6,
            "type": "string"
          },
          "email": {
            "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$",
            "type": "string",
            "description": "must be unique",
            "example": "example@example.dev"
          }
        },
        "additionalProperties": false
      },
      "h05.db.UserViewModel": {
        "required": ["createdAt", "email", "id", "login"],
        "type": "object",
        "properties": {
